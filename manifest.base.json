{
  "manifest_version": 3,
  "name": "Google AI Blocker",
  "version": "1.0.0",
  "description": "Stops Google's AI Overview: skips generating it entirely, and removes it from the results page if it shows up anyway.",
  "minimum_chrome_version": "108",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": [],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [],
      "js": [
        "src/shared/defaults.js",
        "src/content/detector.js",
        "src/content/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Google AI Blocker",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "skip-ai-overview",
        "enabled": true,
        "path": "rules/network-rules.json"
      }
    ]
  }
}
